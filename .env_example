# Blink account credentials
BLINK_CAMERA_AUTO_ARM_USERNAME=your@email.com
BLINK_CAMERA_AUTO_ARM_PASSWORD=yourpassword

# Telegram bot token from @BotFather
TELEGRAM_BOT_TOKEN=123456789:ABC-your-token

# Telegram group chat ID where the bot lives
# Get it from @userinfobot or by inspecting bot updates
TELEGRAM_CHAT_ID=-100123456789

# Your personal Telegram user ID (integer) — only this user's commands are obeyed
# Get it by messaging @userinfobot on Telegram
TELEGRAM_ALLOWED_USER_ID=123456789

# Optional: logging level (DEBUG, INFO, WARNING). Default: INFO
LOG_LEVEL=INFO
